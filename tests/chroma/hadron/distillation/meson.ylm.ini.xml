<?xml version="1.0"?>

<chroma>
<Param>
  <InlineMeasurements>

    <elem>
      <Name>MESON_MATELEM_COLORVEC_YLM_SUPERB</Name>
      <Frequency>1</Frequency>
      <Param>
        <version>4</version>
        <mom2_min>0</mom2_min>
        <mom2_max>3</mom2_max>
        <mom_list>
          <elem>0 0 0</elem>
          <elem>1 0 0</elem>
          <elem>-1 0 0</elem>
          <elem>1 1 0</elem>
          <elem>-1 -1 0</elem>
          <elem>1 1 1</elem>
          <elem>-1 -1 -1</elem>
        </mom_list>
        <num_vecs>10</num_vecs>
        <displacement_length>1</displacement_length>
        <decay_dir>3</decay_dir>
        <t_source>0</t_source>
        <Nt_forward>4</Nt_forward>

        <!-- List of derivative arrays -->
        <ylm_list>
          <!-- No derivatives -->
          <elem>0</elem>

          <!-- One derivative: J=1 -->
          <elem>1 -1</elem>
          <elem>1 0</elem>
          <elem>1 1</elem>

          <!-- Two derivatives: J=0 -->
          <elem>2 0 0</elem>

          <!-- Two derivatives: J=1 -->
          <elem>2 1 -1</elem>
          <elem>2 1 0</elem>
          <elem>2 1 1</elem>

          <!-- Two derivatives: J=2 -->
          <elem>2 2 -2</elem>
          <elem>2 2 -1</elem>
          <elem>2 2 0</elem>
          <elem>2 2 1</elem>
          <elem>2 2 2</elem>

          <!-- Three derivatives: J13=0, J=1 -->
          <elem>3 0 1 -1</elem>
          <elem>3 0 1 0</elem>
          <elem>3 0 1 1</elem>

          <!-- Three derivatives: J13=1, J=0 -->
          <elem>3 1 0 0</elem>

          <!-- Three derivatives: J13=1, J=1 -->
          <elem>3 1 1 -1</elem>
          <elem>3 1 1 0</elem>
          <elem>3 1 1 1</elem>

          <!-- Three derivatives: J13=1, J=2 -->
          <elem>3 1 2 -2</elem>
          <elem>3 1 2 -1</elem>
          <elem>3 1 2 0</elem>
          <elem>3 1 2 1</elem>
          <elem>3 1 2 2</elem>

          <!-- Three derivatives: J13=2, J=1 -->
          <elem>3 2 1 -1</elem>
          <elem>3 2 1 0</elem>
          <elem>3 2 1 1</elem>

          <!-- Three derivatives: J13=2, J=2 -->
          <elem>3 2 2 -2</elem>
          <elem>3 2 2 -1</elem>
          <elem>3 2 2 0</elem>
          <elem>3 2 2 1</elem>
          <elem>3 2 2 2</elem>

          <!-- Three derivatives: J13=2, J=3 -->
          <elem>3 2 3 -3</elem>
          <elem>3 2 3 -2</elem>
          <elem>3 2 3 -1</elem>
          <elem>3 2 3 0</elem>
          <elem>3 2 3 1</elem>
          <elem>3 2 3 2</elem>
          <elem>3 2 3 3</elem>
        </ylm_list>
        <drop_negative_m>false</drop_negative_m>

        <LinkSmearing>
          <LinkSmearingType>STOUT_SMEAR</LinkSmearingType>
          <link_smear_fact>0.1625</link_smear_fact>
          <link_smear_num>4</link_smear_num>
          <no_smear_dir>3</no_smear_dir>
        </LinkSmearing>

      </Param>
      <NamedObject>
        <gauge_id>default_gauge_field</gauge_id>
        <colorvec_files>
          <elem>./colorvec.mod</elem>
        </colorvec_files>
        <meson_op_file>meson.ylm.nonzero.sdb</meson_op_file>
      </NamedObject>
    </elem>
  </InlineMeasurements>
  <nrow>4 4 4 16</nrow>
</Param>

<RNG>
  <Seed>        
    <elem>11</elem>
    <elem>11</elem>
    <elem>11</elem>
    <elem>0</elem>
  </Seed>
</RNG>

<Cfg>
 <cfg_type>WEAK_FIELD</cfg_type>
 <cfg_file>dummy</cfg_file>
</Cfg>
</chroma>

